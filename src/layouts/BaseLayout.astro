---
import '../styles/base.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  // Used for link previews (Open Graph / Twitter); omitted pages get no image.
  image?: { src: ImageMetadata; alt: string } | undefined;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image && (await getImage({ src: image.src, width: 1200, format: 'jpg' }));
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    {
      ogImage && image && (
        <>
          <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />
          <meta property="og:image:width" content={String(ogImage.attributes.width)} />
          <meta property="og:image:height" content={String(ogImage.attributes.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash of the wrong theme.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <ThemeToggle />
    <slot />
    <CookieBanner />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }
</style>
