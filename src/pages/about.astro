---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../site.config';

const about = await getEntry('pagine', 'about');
if (!about) throw new Error('content/about.md is missing');
const { Content } = await render(about);
const { title, description } = site.pages.about;
---

<PageLayout title={`${title} · ${site.name}`} heading={title} description={description}>
  <div class="prose">
    <Content />
  </div>
</PageLayout>

<style>
  .prose {
    max-width: var(--reading-max);
    margin-inline: auto;
    font-size: var(--text-size-poem);
    line-height: var(--line-height-body);
  }

  .prose :global(p + p) {
    margin-block-start: var(--space-stack);
  }
</style>
