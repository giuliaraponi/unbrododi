---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import PoemGrid from '../../components/PoemGrid.astro';
import { site } from '../../site.config';

export const getStaticPaths = (async () => {
  const poems = await getCollection('poesie');
  return poems.map((poem) => ({ params: { slug: poem.data.slug }, props: { poem } }));
}) satisfies GetStaticPaths;

const { poem } = Astro.props;
const { Content } = await render(poem);
---

<PoemGrid
  title={`${poem.data.title} · ${site.name}`}
  description={poem.data.intro}
  poem={{ slug: poem.data.slug, title: poem.data.title, images: poem.data.images }}
>
  <Content />
</PoemGrid>
