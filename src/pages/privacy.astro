---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import CookieSettings from '../components/CookieSettings.astro';
import { site } from '../site.config';

const privacy = await getEntry('pagine', 'privacy');
if (!privacy) throw new Error('content/privacy.md is missing');
const { Content } = await render(privacy);
const { title, description } = site.pages.privacy;
---

<PageLayout title={`${title} · ${site.name}`} heading={title} description={description}>
  <div class="prose">
    <Content />
  </div>
  <CookieSettings />
</PageLayout>

<style>
  .prose {
    max-width: var(--reading-max);
    margin-inline: auto;
    font-size: var(--text-size-poem);
    line-height: var(--line-height-body);
  }

  .prose :global(h2) {
    margin-block-start: var(--space-stack-lg);
    margin-block-end: var(--space-stack);
    font-size: var(--text-size-card-title);
  }

  .prose :global(p + p),
  .prose :global(p + ul),
  .prose :global(ul + p) {
    margin-block-start: var(--space-stack);
  }

  .prose :global(ul) {
    padding-inline-start: var(--space-stack-lg);
  }
</style>
