---
import { site } from '../site.config';

interface Props {
  title: string;
  intro: string;
  tags: readonly string[];
  slug: string;
}

const { title, intro, tags, slug } = Astro.props;
---

<article class="poem-card">
  <h2 class="title">
    <a href={`/poesie/${slug}/`} class="open" aria-haspopup="dialog" data-poem={slug}>
      {title}
    </a>
  </h2>
  <p class="intro">{intro}</p>
  <p class="tags">
    <span class="visually-hidden">Tag: </span>{tags.join(site.ui.tagSeparator)}
  </p>
</article>

<style>
  .poem-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-stack);
    flex: 1;
    padding: var(--space-card-padding);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition:
      background-color var(--motion-hover-duration) var(--motion-easing),
      box-shadow var(--motion-hover-duration) var(--motion-easing);
  }

  .poem-card:hover,
  .poem-card:has(.open:focus-visible) {
    background: var(--surface-muted);
    box-shadow: var(--shadow-card-hover);
  }

  .poem-card:has(.open:focus-visible) {
    outline: var(--focus-outline-width) solid var(--focus-ring);
    outline-offset: var(--focus-outline-offset);
  }

  .title {
    font-size: var(--text-size-card-title);
  }

  .open {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the button's hit area over the whole card. */
  .open::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .open:focus-visible {
    outline: none;
  }

  .intro {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--card-intro-lines);
    line-clamp: var(--card-intro-lines);
    overflow: hidden;
    color: var(--text-secondary);
    font-family: var(--font-poem);
  }

  .tags {
    margin-top: auto;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-size-meta);
    letter-spacing: var(--letter-spacing-meta);
  }
</style>
