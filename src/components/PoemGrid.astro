---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PoemCard from './PoemCard.astro';
import PoemDialog from './PoemDialog.astro';
import { site } from '../site.config';
import type { ComponentProps } from 'astro/types';

interface Props {
  title: string;
  description: string;
  // The poem whose dialog this page opens; its full text is the only one in the page.
  poem?: ComponentProps<typeof PoemDialog>['poem'];
}

const { title, description, poem } = Astro.props;
const poems = (await getCollection('poesie')).sort((a, b) => a.data.title.localeCompare(b.data.title, site.lang));
const listTitle = `${site.pages.poems.title} · ${site.name}`;
---

<PageLayout title={title} heading={site.pages.poems.title} description={description}>
  <PoemDialog poem={poem}><slot /></PoemDialog>
  <ul class="grid" data-list-title={listTitle}>
    {
      poems.map((entry) => (
        <li>
          <PoemCard title={entry.data.title} intro={entry.data.intro} tags={entry.data.tags} slug={entry.data.slug} />
        </li>
      ))
    }
  </ul>
  <noscript>
    <style is:inline>
      /* Without JavaScript, show the page's poem above the grid. */
      dialog.poem-dialog[data-slug]:not([open]) {
        position: static;
        display: block;
        width: auto;
        max-height: none;
        margin-block-end: var(--space-stack-lg);
      }
      .poem-dialog .close-bar {
        display: none;
      }
    </style>
  </noscript>
</PageLayout>

<script>
  import { initPoemDialogs } from '../scripts/poem-dialog';
  initPoemDialogs();
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    gap: var(--space-grid-gap);
    padding: var(--space-none);
    list-style: none;
  }

  .grid > li {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
