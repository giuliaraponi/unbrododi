---
import { site } from '../site.config';
---

<button
  type="button"
  class="theme-toggle"
  data-label-dark={site.ui.themeToDark}
  data-label-light={site.ui.themeToLight}
  aria-label={site.ui.themeToDark}
  hidden
>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle';
  initThemeToggle();
</script>

<style>
  .theme-toggle {
    position: absolute;
    top: var(--space-chrome);
    right: var(--space-chrome);
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: var(--space-none);
    border: none;
    border-radius: var(--radius-control);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--motion-hover-duration) var(--motion-easing);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--action-primary);
  }

  .icon {
    width: var(--icon-size);
    height: var(--icon-size);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon of the theme the button switches to. */
  .icon-sun,
  :global([data-active-theme='dark']) .icon-moon {
    display: none;
  }

  :global([data-active-theme='dark']) .icon-sun {
    display: block;
  }
</style>
